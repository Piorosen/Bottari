# Copy to Config/release.env (not committed) and fill in once.

# Apple Developer team ID, the ten characters in "Developer ID Application: Name (TEAMID)".
TEAM_ID=

# A notarytool profile kept in your keychain. Create it once with:
#   xcrun notarytool store-credentials bottari-notary --apple-id you@example.com --team-id TEAMID
# (it asks for an app-specific password from account.apple.com).
NOTARY_PROFILE=bottari-notary

# Sparkle's EdDSA public key, printed by scripts/sparkle-keys.sh. The private
# key stays in your login keychain.
SPARKLE_PUBLIC_KEY=

# Optional: a Google Cloud OAuth client of type "Desktop app", so Google Drive
# sites sign in without each user making a client of their own. Google treats a
# desktop client's secret as public; it ships inside the app. Publish the
# consent screen (or users must sign in again every 7 days while it is in testing).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the app looks for updates. GitHub's "latest release" link works when
# each release uploads its appcast.xml.
FEED_URL=https://github.com/Piorosen/Bottari/releases/latest/download/appcast.xml
DOWNLOAD_URL_PREFIX=https://github.com/Piorosen/Bottari/releases/download
