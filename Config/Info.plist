<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Sparkle stays off while the key is empty (Debug builds). -->
	<key>SUFeedURL</key>
	<string>$(BOTTARI_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(BOTTARI_SPARKLE_PUBLIC_KEY)</string>
	<!-- The Google Cloud OAuth client (Desktop app) that Google Drive sites use
	     unless they name their own. Empty: each site needs its own client. -->
	<key>BottariGoogleClientID</key>
	<string>$(BOTTARI_GOOGLE_CLIENT_ID)</string>
	<key>BottariGoogleClientSecret</key>
	<string>$(BOTTARI_GOOGLE_CLIENT_SECRET)</string>
</dict>
</plist>
