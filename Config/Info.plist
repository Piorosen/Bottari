<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Sparkle stays off while the key is empty (Debug builds). -->
	<key>SUFeedURL</key>
	<string>$(BOTTARI_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(BOTTARI_SPARKLE_PUBLIC_KEY)</string>
	<!-- The Google Cloud OAuth client (Desktop app) that Google Drive sites use
	     unless they name their own. Empty: each site needs its own client. -->
	<key>BottariGoogleClientID</key>
	<string>$(BOTTARI_GOOGLE_CLIENT_ID)</string>
	<key>BottariGoogleClientSecret</key>
	<string>$(BOTTARI_GOOGLE_CLIENT_SECRET)</string>
	<!-- Export compliance, as answered in App Store Connect: standard algorithms
	     only (SSH, HTTPS), so no documents, and builds reach TestFlight without asking. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- What a drag between panes carries; only Bottari itself can read it. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.piorosen.bottari.pane-items</string>
			<key>UTTypeDescription</key>
			<string>Bottari items</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- Why macOS asks for access; the English text is in Bottari/InfoPlist.xcstrings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>집이나 회사 네트워크에 있는 NAS와 서버에 연결합니다.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>데스크탑의 파일을 보여 주고 서버와 주고받습니다.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>문서 폴더의 파일을 보여 주고 서버와 주고받습니다.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>다운로드 폴더의 파일을 보여 주고 서버와 주고받습니다.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>외장 디스크의 파일을 보여 주고 서버와 주고받습니다.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>네트워크 볼륨의 파일을 보여 주고 서버와 주고받습니다.</string>
</dict>
</plist>
