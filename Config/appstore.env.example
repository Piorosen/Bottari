# Copy to Config/appstore.env (not committed) and fill in once; used by scripts/testflight.sh.

# Apple Developer team ID.
TEAM_ID=

# An App Store Connect API key (Users and Access › Integrations › Keys, role
# App Manager or Admin). The .p8 file is looked for in
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 unless ASC_KEY_PATH says otherwise.
ASC_KEY_ID=
ASC_ISSUER_ID=
# ASC_KEY_PATH=

# Optional: the bundle ID registered for the App Store app, if not the project's
# io.github.piorosen.bottari.appstore.
# BUNDLE_ID=

# Optional: a Google Cloud OAuth client of type "Desktop app", so Google Drive
# sites sign in without each user making a client of their own. Google treats a
# desktop client's secret as public; it ships inside the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
