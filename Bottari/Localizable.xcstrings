        }
      }
    },
    "%@/에 저장됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved in %@/"
          }
        }
      }
    },
    "%@:%lld 연결 실패 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%lld connection failed · %@"
          }
        }
      }
    },
    "%@로 가는 경로가 없습니다. 네트워크 또는 VPN 연결을 확인하십시오.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no route to %@. Check your network or VPN connection."
          }
        }
      }
    },
    "%@로 저장할 수 없는 문자가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some characters can’t be saved as %@."
          }
        }
      }
    },
    "%@에 맞춰 “%@” 삭제됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” deleted to match %1$@"
          }
        }
      }
    },
