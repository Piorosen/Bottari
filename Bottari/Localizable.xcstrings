    "%@ 주소를 찾을 수 없습니다. 호스트 이름을 확인하고, 사내 주소라면 VPN 연결을 확인하십시오.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t find the address %@. Check the host name, and if it is an internal address, check your VPN connection."
          }
        }
      }
    },
    "%@ 직접 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ direct"
          }
        }
      }
    },
    "%@ 항목 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ items"
          }
        }
      }
    },
    "%@$ tar -cf - … | ssh %@ tar -xpf -\n  %@\n  → %@\nMac을 거치지 않음, 대상 로그인은 에이전트 포워딩": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@$ tar -cf - … | ssh %@ tar -xpf -\n  %@\n  → %@\nNever passes through the Mac; the destination login is forwarded as an agent"
          }
        }
      }
    },
    "%@(으)로 이동": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to %@"
          }
        }
      }
    },
    "%@, 폴더": {
